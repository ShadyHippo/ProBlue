+#define PROCON_SPI_PAIR_MAGIC	0x95
+#define PROCON_SPI_PAIR_OFFSET	0x2000
+#define PROCON_SPI_MAC_OFFSET	0x04	/* 6B host MAC, big-endian */
+#define PROCON_SPI_LTK_OFFSET	0x0a	/* 16B LTK, little-endian */

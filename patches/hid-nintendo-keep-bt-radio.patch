+static inline bool joycon_is_passive(struct joycon_ctlr *ctlr)
+{
+	/*
+	 * Fork: every transport this driver binds (USB + BT) is passive — see
+	 * the probe/init fork comments. The pairing flow (bluetoothd's procon
+	 * plugin) owns the controller on both: wired subcommands over hidraw,
+	 * BT input via bluetoothd's HID profile (uhid), BT subcommands over the
+	 * plugin's own PSM 0x13 channel. Kept as an explicit transport check (not
+	 * "always true") so a future transport added to the id table would
+	 * have to be reviewed here.
+	 */
+	return joycon_using_usb(ctlr) || ctlr->hdev->bus == BUS_BLUETOOTH;
+}

+/* Re-read every BR/EDR link key from storage and reload the kernel list via
+ * MGMT_OP_LOAD_LINK_KEYS (full-list replacement — the only runtime key-add
+ * path in BlueZ 5.84; there is no MGMT_OP_ADD_LINK_KEY). Mirrors the
+ * key-collection portion of load_devices() so runtime registrations (cable
+ * pairing) coexist with everything bluetoothd already knows. */
+static void reload_link_keys(struct btd_adapter *adapter)
+{
+	char dirname[PATH_MAX];
+	GSList *keys = NULL;
+	GError *gerr = NULL;
+	DIR *dir;
+	struct dirent *entry;
+
+	create_filename(dirname, PATH_MAX, "/%s",
+				btd_adapter_get_storage_dir(adapter));
+
+	dir = opendir(dirname);
+	if (!dir) {
+		btd_error(adapter->dev_id,
+				"Unable to open adapter storage directory: %s",
+								dirname);
+		return;
+	}
+
+	while ((entry = readdir(dir)) != NULL) {
+		struct link_key_info *key_info;
+		char filename[PATH_MAX];
+		GKeyFile *key_file;
+		uint8_t bdaddr_type;
+
+		if (entry->d_type == DT_UNKNOWN)
+			entry->d_type = util_get_dt(dirname, entry->d_name);
+
+		if (entry->d_type != DT_DIR || bachk(entry->d_name) < 0)
+			continue;
+
+		create_filename(filename, PATH_MAX, "/%s/%s/info",
+					btd_adapter_get_storage_dir(adapter),
+					entry->d_name);
+
+		key_file = g_key_file_new();
+		if (!g_key_file_load_from_file(key_file, filename, 0, &gerr)) {
+			g_clear_error(&gerr);
+			g_key_file_free(key_file);
+			continue;
+		}
+
+		bdaddr_type = get_addr_type(key_file);
+		key_info = get_key_info(key_file, entry->d_name, bdaddr_type);
+		g_key_file_free(key_file);
+
+		if (!key_info)
+			continue;
+
+		keys = g_slist_append(keys, key_info);
+	}
+
+	closedir(dir);
+
+	load_link_keys(adapter, keys, btd_opts.debug_keys);
+	g_slist_free_full(keys, g_free);
+}
+
+/* Runtime BR/EDR link-key registration for cable-paired devices: persist the
+ * key bluetoothd-style (info file [LinkKey] section) and load it into the
+ * kernel. Called by plugins/sixaxis.c for the Pro Controller — the 3-step
+ * returns the LTK over USB, and the controller connects with that key only
+ * (no over-the-air SSP), so it must be registered before the first connect. */
+void btd_adapter_store_link_key(struct btd_adapter *adapter,
+				struct btd_device *device, const uint8_t *key,
+				uint8_t type, uint8_t pin_length)
+{
+	store_link_key(adapter, device, key, type, pin_length);
+
+	reload_link_keys(adapter);
+}
